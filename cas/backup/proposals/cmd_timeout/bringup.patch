+    def check_cmd_timeout(self):
+        # Use a local monotonic clock so ROS clock changes cannot extend the timeout.
+        if not self.is_initialized or not self.cmd_watchdog_armed:
+            return
+        if (self.last_cmd_monotonic is not None and
+                time.monotonic() - self.last_cmd_monotonic < self.cmd_vel_timeout):
+            return
